# ─────────────────────────────────────────────────────────────────────────────
# Micro-News Aggregator — ortam değişkenleri şablonu
#
# Kullanım:  cp .env.example .env  → değerleri doldur.
# UYARI: Bu dosyaya GERÇEK sırları koymayın; yalnızca .env (git dışı) içinde
# tutun. Aşağıdaki "your-secret-here" değerleri yer tutucudur.
# ─────────────────────────────────────────────────────────────────────────────

# ── Veritabanı (Prisma / SQLite) ─────────────────────────────────────────────
# SQLite dosya yolu. Docker içinde entrypoint varsayılanı:
#   file:/app/prisma/data/news.db  (news_data volume'unda kalıcıdır)
# Yerel geliştirmede bırakabilirsiniz.
DATABASE_URL="file:./prisma/data/news.db"

# ── Yönetim / Basic Auth (admin paneli + cron yedeği) ────────────────────────
# Owner oturumu yoksa HTTP Basic Auth yedeği bu kimlikle çalışır.
# Tüm /api/admin, /api/cron/*, X Stüdyo, video-news ve podcast uçlarını açar.
ADMIN_USER="admin"
# ZORUNLU (docker-compose boşsa başlamaz). Güçlü, uzun bir parola seçin;
# deploy.sh "change-me-now" ile dağıtmayı reddeder.
ADMIN_PASSWORD="your-secret-here"

# ── Auth.js (NextAuth v5) ────────────────────────────────────────────────────
# JWT oturum imzalama anahtarı. Üretimde MUTLAKA set edin:
#   openssl rand -hex 32
# Set edilmezse kod güvenli olmayan bir dev sabitine düşer (risk!).
AUTH_SECRET="your-secret-here"
# NextAuth v4 uyumluluk adı (AUTH_SECRET yoksa bu kullanılır; biri yeter).
# NEXTAUTH_SECRET="your-secret-here"
# Site adresi — Auth.js geri dönüş (callback) URL'leri için.
AUTH_URL="http://localhost:3000"

# ── Google OAuth (opsiyonel) ─────────────────────────────────────────────────
# Boş bırakılırsa site anonim çalışır, Google giriş düğmesi gizlenir.
# Google Cloud Console → OAuth 2.0 istemci kimliği.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Owner e-postaları ────────────────────────────────────────────────────────
# Yönetim/moderasyon yetkisi olan hesaplar (virgülle ayrılmış liste).
# Boş bırakılırsa kodda gömülü varsayılan adresler kullanılır.
OWNER_EMAIL="owner@example.com"

# ── Site ─────────────────────────────────────────────────────────────────────
# Kanonik site URL'si (robots.ts, sitemap.ts, metadata, paylaşım linkleri).
SITE_URL="http://localhost:3000"
# Varsayılan dil (/ → /{locale} yönlendirmesi). tr | en
DEFAULT_LOCALE="tr"

# ── Zamanlanmış işler (instrumentation.ts) ───────────────────────────────────
# "false" → dahili cron'lar (10 dk sentez + saatlik denetim) kapatılır;
# harici crontab/aaPanel ile /api/cron/process çağıracaksanız kapatın.
ENABLE_INTERNAL_CRON="true"
# Harici cron çağrıları için ek anahtar:  /api/cron/process?key=…
# Boşsa Basic Auth (ADMIN_USER/ADMIN_PASSWORD) kullanılır.
CRON_SECRET_KEY=""

# ── LLM modelleri (SystemSettings'ten değil env'den seçilenler) ──────────────
# Yayın öncesi denetçi modeli (ön-yayın kalite kapısı).
REVIEWER_MODEL="qwen3-vl-30b"
# Saatlik yayın sonrası denetçi modeli.
AUDITOR_MODEL="gemma-4-31b"
# Ana sentez sağlayıcısı, API anahtarı ve model adı .env'te DEĞİL, admin
# panelinden (SystemSettings tablosu) yönetilir: /tr/admin → LLM ayarları.

# ── Sesli Özet TTS (VoxCPM 2, LLM sağlayıcısıyla aynı anahtar) ──────────────
# OpenAI uyumlu /audio/speech model adı.
TTS_MODEL="voxcpm2"

# ── Telifsiz AI Görsel (lib/imagegen + lib/portrait-image) ───────────────────
# Zincir: Cloudflare Workers AI (kimlik varsa) → Pollinations (anahtarsız) → SVG.
#
# POLLINATIONS: hiçbir ayar GEREKMEZ, anahtarsız çalışır. Hiçbir env
# tanımlamazsanız görseller yine üretilir.
#
# CLOUDFLARE (opsiyonel, kalite/hız için önerilir):
#   1. https://dash.cloudflare.com → Workers & Pages → AI
#   2. Hesap ID'si panelin sağ üstünde / URL'de görünür
#   3. API Token: My Profile → API Tokens → "Workers AI" şablonu
CF_AI_ACCOUNT_ID=""
# Boş bırakılabilir — boşsa yalnızca Pollinations kullanılır.
CF_AI_TOKEN=""

# ── PWA Web Push (VAPID) ──────────────────────────────────────────────────────
# Anahtar üretimi:  npx web-push generate-vapid-keys
# Set edilmezse push gönderimi sessizce devre dışı kalır (abonelik kaydı çalışır).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Push servisine bildirilen iletişim adresi (opsiyonel).
VAPID_SUBJECT="mailto:admin@example.com"

# ── Docker / dağıtım (docker-compose.yml + deploy.sh) ────────────────────────
# Port bağlama adresi. Nginx/aaPanel arkasındaysanız "127.0.0.1" yapın.
BIND_HOST="0.0.0.0"
# Host port'u (konteyner her zaman 3000 dinler).
APP_PORT="3000"

# deploy.sh override'ları (uygulama değil, betik davranışı):
# SSH_KEY="$HOME/.ssh/id_ed25519"
# VPS_HOST="1.2.3.4"
# VPS_USER="root"
# SSH_PORT="22"
# REMOTE_DIR="/opt/news"

# ─── AI sağlayıcı (çoklu) ────────────────────────────────────────────────────
# Panelden de seçilebilir (SystemSettings). Env yalnızca ilk kurulum varsayılanı.
# openai | anthropic | gemini | deepseek | openrouter | groq | mistral | ollama
LLM_PROVIDER="openai"
LLM_BASE_URL="https://api.openai.com/v1"
LLM_MODEL="gpt-4o-mini"
# Anahtar panelden de girilebilir; env'de bırakmak zorunlu değil.
LLM_API_KEY=""

# Yönetim paneli sahibi (virgülle ayrılmış e-posta listesi). BOŞ = kimse owner değil.
OWNER_EMAIL=""

# ─── Portre modülü (Ek Bölüm 9) ──────────────────────────────────────────────
# Dış hikâye akışı ve otomasyon sınırları.
# Çalışma saatleri (Europe/Istanbul): 08:30, 19:00 — sağlık kontrolü 00:15.
# Sabah çalıştırması üretemezse akşam çalıştırması 2 portre üretir (telafi).
# Sabit saatler lib/hq/config.ts → SCHEDULE içindedir; aşağıdaki env'ler yalnız
# hat sınırlarını değiştirir.
# Birincil dış akış. Kendi RSS'inizi de verebilirsiniz.
PORTRAIT_FEED_URL=https://kantan.news/feed
# Akış makale döndürmezse kullanılacak yedek (Google News sitemap).
PORTRAIT_SITEMAP_URL=https://kantan.news/sitemap-news-tr.xml
# Kaç saatlik içerik değerlendirilir.
PORTRAIT_WINDOW_HOURS=48
# GÜNLÜK TOPLAM üretim hedefi (telafi kuralı bunu esas alır).
# 2 = sabah 1 + akşam 1; sabah kaçarsa akşam 2 üretir.
PORTRAIT_PER_DAY=2
# Tek çalıştırmada en fazla kaç deneme (yedek konu dahil).
PORTRAIT_MAX_PER_RUN=2

# Kademeli açılış (önerilen): AUTO_PUBLISH=true + SHADOW_START tarihini gir.
# Gölge süresince portre YAYINLANIR ve `reviewNotes` içinde "GÖLGE MOD" işareti
# taşır; owner panelden tek tıkla geri çekebilir. SHADOW_DAYS gün sonunda
# otomatik yayın KENDİLİĞİNDEN KAPANMAZ (fail-safe).
PORTRAIT_AUTO_PUBLISH=true
PORTRAIT_SHADOW_START=
PORTRAIT_SHADOW_DAYS=14

# GDELT arşiv kaynağı (429 alırsa 30 dk otomatik devre dışı kalır).
PORTRAIT_USE_GDELT=true
# Portre zamanlayıcısı (08:30 / 19:00 / 00:15). false → tamamen kapanır.
ENABLE_PORTRAIT_CRON=true
# Haftalık atıf denetimi (pazartesi 03:00). false → kapanır.
ENABLE_CITATION_AUDIT=true
